@startuml usart_tx_configure_sequence
title USART TX and runtime reconfiguration from the web UI
autonumber

participant "Writer thread" as W
participant "HTTP thread\nUartConfigService" as H
participant "ThreadxSerial<Port>" as S
participant "Usart<Port>" as U
participant "TxDma\nStream<kDma1, 1>" as D
participant "USART3 HW" as HW
participant "DMA1_Stream1_IRQHandler" as DI

== Write ==
W -> S : Write(data, timeout)
S -> S : tx_mutex_get(tx_mutex_)
loop until all bytes sent
  S -> S : clear kTxDoneFlag
  S -> U : Write(remaining data)
  U -> U : tx_busy_ = true\ncopy up to kTxBufferSize bytes to TxBuffer()
  U -> D : Start(&TDR, TxBuffer(), n)
  U --> S : n
  S -> S : tx_event_flags_get(kTxDoneFlag)
  D -> HW : bytes
  D -> DI : TC (or TE / DME)
  DI -> U : OnTxDma(events)
  U -> U : tx_busy_ = false
  U -> S : callback(kTxComplete or kTxDmaError)
  S -> S : tx_event_flags_set(kTxDoneFlag)
end
S -> S : tx_mutex_put(tx_mutex_)
S --> W : expected<size_t>(total)

== Configure (web UI POST /api/uart/config) ==
H -> H : validate() (enum ranges), find binding for port_id
H -> S : binding.apply -> Configure(uart::Config)
S -> S : get tx_mutex_, then rx_mutex_\n(waits for running Write / Read)
S -> U : Configure(config)
U -> U : ComputeBrr(KernelClockHz(), baud, oversampling)\nIsValid() (RTS/CTS pins)
U -> D : TxDma::Stop(), RxDma::Stop()
U -> HW : wait ISR.TC, CR1.UE = 0
U -> HW : write CR1, CR2, CR3, BRR, PRESC
U -> D : Configure TX / RX streams, SetCallback
U -> U : reset ring (rx_head_ = rx_tail_ = 0)
U -> D : RxDma::Start(&RDR, RxBuffer(), size)
U -> HW : ICR clear, CR1.UE = 1
U --> S : expected<void>
S -> S : release rx_mutex_, tx_mutex_
S --> H : expected<void>
H --> H : 204 No Content (422 if rejected)
@enduml
